# Ejemplo de configuración. Copiá este archivo como ".env" y completá tus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore) porque tiene contraseñas.

# Clave secreta de Django. Generá una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria

# True mientras desarrollamos, False en producción.
DEBUG=True

# Dominios desde los que se puede entrar al sistema, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1

# Conexión a MySQL (la base "sgh" se crea antes desde MySQL Workbench).
DB_NAME=sgh
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
